{
  "expo": {
    "name": "스파크 서바이버",
    "slug": "spark-survivor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16161F",
    "primaryColor": "#7EA8FF",
    "splash": {
      "backgroundColor": "#16161F",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.hijimin.sparksurvivor",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hijimin.sparksurvivor",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#16161F"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ]
  }
}
